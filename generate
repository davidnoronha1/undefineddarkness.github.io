#!/usr/bin/env bash
# Site commands. Runs natively wherever `uv` is installed (build.py pulls its
# own Python deps); without uv it falls back to the Docker container.
#
#   ./generate [src files...]   build the site (all pages if no files given)
#   ./generate live             live-reloading preview on :5000
#   ./generate serve            static server over the repo on :5050
#   ./generate deploy           build + `bunx vercel`
#   ./generate winfix           dos2unix src/ (CRLF from Windows editors)
set -euo pipefail
cd "$(dirname "$0")"

if ! command -v uv >/dev/null && [ ! -f /.dockerenv ]; then
	docker compose up -d generate
	if [ -n "${DEBUG:-}" ]; then
		exec docker compose exec -e DEBUG generate ./generate "$@"
	fi
	exec docker compose exec generate ./generate "$@"
fi

case "${1:-}" in
live)   exec ./.tooling/hs.py --ui ;;
serve)  exec python3 -m http.server 5050 ;;
deploy) ./generate && exec bunx vercel ;;
winfix) find src -type f -not -path '*/.*' -print0 | xargs -0 dos2unix; exit ;;
esac

export NES_GENERATE=1	# tell build.py it wasn't run directly
./build.py "$@"
# Hash/transcode media into out/.assets and rewrite references to match.
./.tooling/assets.py sync out experiments
